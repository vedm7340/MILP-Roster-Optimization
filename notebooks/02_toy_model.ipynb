using JuMP
using HiGHS

using MathOptInterface
const MOI = MathOptInterface

model = Model(HiGHS.Optimizer)

players = ["N. Jokic", "J. Murray", "M. Porter Jr.", "A. Gordon", "B. Hyland", "K. Caldwell-Pope", "R. Jackson", "J. Green", "Z. Nnaji", "D. Jordan", "V. Cancar", "C. Braun"]

position = Dict("N. Jokic" => "C", "J. Murray" => "PG", "M. Porter Jr." => "SF", "A. Gordon" => "PF", "B. Hyland" => "SG", "K. Caldwell-Pope" => "SG", "R. Jackson" => "PG", "J. Green" => "PF", "Z. Nnaji" => "PF", "D. Jordan" => "C", "V. Cancar" => "PF", "C. Braun" => "SG")
ppg = Dict("N. Jokic" => 24.5, "J. Murray" => 20.0, "M. Porter Jr." => 17.4, "A. Gordon" => 16.3, "B. Hyland" => 12.1, "K. Caldwell-Pope" => 10.8, "R. Jackson" => 7.9, "J. Green" => 7.8, "Z. Nnaji" => 5.2, "D. Jordan" => 5.1, "V. Cancar" => 5, "C. Braun" => 4.7)
per = Dict("N. Jokic" => 31.5, "J. Murray" => 17.9, "M. Porter Jr." => 16.8, "A. Gordon" => 19.5, "B. Hyland" => 14.4, "K. Caldwell-Pope" => 11.5, "R. Jackson" => 8.9, "J. Green" => 11.0, "Z. Nnaji" => 12.6, "D. Jordan" => 14.8, "V. Cancar" => 11.0, "C. Braun" => 10.3)
ws = Dict("N. Jokic" => 14.9, "J. Murray" => 5.1, "M. Porter Jr." => 4.3, "A. Gordon" => 6.8, "B. Hyland" => 0.9, "K. Caldwell-Pope" => 4.5, "R. Jackson" => 0.1, "J. Green" => 1.7, "Z. Nnaji" => 1.6, "D. Jordan" => 1.4, "V. Cancar" => 1.7, "C. Braun" => 1.9)

salary = Dict("N. Jokic" => 33.0, "J. Murray" => 31.7, "M. Porter Jr." => 30.9, "A. Gordon" => 19.7, "B. Hyland" => 2.2, "K. Caldwell-Pope" => 14.0, "R. Jackson" => 0.6, "J. Green" => 4.5, "Z. Nnaji" => 2.6, "D. Jordan" => 1.8, "V. Cancar" => 2.2, "C. Braun" => 2.8)

@variable(model, selected[players], Bin)

w_per = 0.45
w_ppg = 0.3
w_ws = 0.25

@objective(model, Max, sum((w_ws * ws[p] + w_per * per[p] + w_ppg * ppg[p]) * selected[p] for p in players))

@constraint(model, sum(salary[p] * selected[p] for p in players) <= 100)

@constraint(model, sum(selected[p] for p in players if position[p] == "PG") >= 1)
@constraint(model, sum(selected[p] for p in players if position[p] == "PG") <= 2)

@constraint(model, sum(selected[p] for p in players if position[p] == "SG") >= 1)
@constraint(model, sum(selected[p] for p in players if position[p] == "SG") <= 2)

@constraint(model, sum(selected[p] for p in players if position[p] == "SF") >= 1)
@constraint(model, sum(selected[p] for p in players if position[p] == "SF") <= 2)

@constraint(model, sum(selected[p] for p in players if position[p] == "PF") >= 1)
@constraint(model, sum(selected[p] for p in players if position[p] == "PF") <= 2)

@constraint(model, sum(selected[p] for p in players if position[p] == "C") >= 1)
@constraint(model, sum(selected[p] for p in players if position[p] == "C") <= 2)

@constraint(model, sum(selected[p] for p in players) == 7)

optimize!(model)

selected_players = [
    p for p in players
    if value(selected[p]) > 0.5
]

if termination_status(model) != MOI.OPTIMAL
    println("Solver status: ",
            termination_status(model))
else
    println("Selected Players: ", selected_players)

    println("Total PPG: ", sum(ppg[p] for p in selected_players))
    println("Total PER: ", sum(per[p] for p in selected_players))
    println("Total WS: ", sum(ws[p] for p in selected_players))
end

