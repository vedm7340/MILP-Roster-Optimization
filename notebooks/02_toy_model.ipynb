from pulp import *

players = ['A', 'B', 'C', 'D', 'E', 'F', 'G']
ws = {'A': 8.2, 'B': 6.1, 'C': 7.5, 'D': 5.0, 'E': 9.1, 'F': 4.3, 'G': 6.8}
salary = {'A': 12, 'B': 8, 'C': 15, 'D': 6, 'E': 18, 'F': 5, 'G': 10}

prob = LpProblem("ToyRoster", LpMaximize)
x = LpVariable.dicts("select", players, cat="Binary")

prob += lpSum(ws[p] * x[p] for p in players)  #objective
prob += lpSum(salary[p] * x[p] for p in players) <= 35  #cap
prob += lpSum(x[p] for p in players) == 4   #roster size

prob.solve()
print("Selected:", [p for p in players if x[p].value() == 1])
print("Total WS:", sum(ws[p] for p in players if x[p].value() == 1))
